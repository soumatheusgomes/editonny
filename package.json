{
  "name": "editonny-dev",
  "private": true,
  "workspaces": [
    "design-system",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w @editonny/web",
    "build": "npm run build -w @editonny/web",
    "icons": "node design-system/scripts/icons.mjs",
    "check:icons": "node design-system/scripts/icons.mjs --check",
    "readme:art": "node scripts/readme-art/build.mjs",
    "test": "node scripts/python.mjs -m unittest discover -s tests -p \"test_*.py\" && node --test tests/eslint-config.test.mjs tests/design-system.test.mjs tests/three-engine.test.mjs tests/preview-api.test.mjs tests/readme-art.test.mjs && vitest run",
    "test:browser": "npm run test:e2e -w @editonny/web",
    "lint": "eslint . --max-warnings 0",
    "lint:rules": "node eslint-rules/verify.mjs ./eslint-rules/index.cjs",
    "typecheck": "tsc -p design-system && npm run typecheck -w @editonny/web",
    "check": "npm run lint:rules && npm run lint && npm run typecheck && npm test && npm run check:icons",
    "test:engine": "uv run --locked --directory skills/editonny/engine python -m unittest discover -s ../../../tests/integration -p \"test_*.py\"",
    "test:preview": "node --test tests/preview-browser.test.mjs",
    "graph:check": "node scripts/python.mjs scripts/project_graph.py check",
    "graph:update": "node scripts/python.mjs scripts/project_graph.py update",
    "graph:code": "node scripts/python.mjs scripts/project_graph.py code",
    "graph:exports": "node scripts/python.mjs scripts/project_graph.py exports",
    "graph:watch": "node scripts/python.mjs scripts/project_graph.py watch",
    "graph:test": "node scripts/python.mjs scripts/project_graph.py test",
    "test:scenes": "node --test tests/template-scenes.test.mjs",
    "test:three": "node scripts/smoke_three.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "author": {
    "name": "Matheus Gomes",
    "email": "eu@matheusgom.es",
    "url": "https://instagram.com/matheusgomes"
  },
  "homepage": "https://github.com/soumatheusgomes/editonny#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/soumatheusgomes/editonny.git"
  },
  "bugs": {
    "url": "https://github.com/soumatheusgomes/editonny/issues"
  }
}
